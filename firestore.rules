rules_version = '2';

// Swipeinn Firestore security model (Phase 2)
// ---------------------------------------------------------------------------
// users/{uid}                        private profile
// listings/{listingId}               readable by any signed-in account
// listings/{listingId}/likes/{uid}   one requester's interest, doc ID = UID
// matches/{listingId_requesterUid}   created by the listing owner on approval
// matches/{id}/messages/{messageId}  senderUid must equal the writer
//
// Writes require a verified email. Only the listing owner can read the likes
// queue or create a match, and a match requires an existing like.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function listingData(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data;
    }

    function isListingOwner(listingId) {
      return isSignedIn() && listingData(listingId).ownerUid == request.auth.uid;
    }

    function isParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participantUids;
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchParticipant(matchId) {
      return isSignedIn() &&
        request.auth.uid in matchData(matchId).participantUids;
    }

    // One private profile per account.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /swipes/{targetId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Per-user app settings.
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Places published by any account.
    match /listings/{listingId} {
      allow read: if isSignedIn();

      allow create: if isVerified() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == listingId;

      allow update: if isVerified() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isVerified() &&
        resource.data.ownerUid == request.auth.uid;

      // One interest request per requester. The owner reads the queue and
      // closes an entry by approving it; history is kept instead of deleted.
      match /likes/{likeId} {
        allow read: if isSignedIn() && (
          request.auth.uid == likeId || isListingOwner(listingId)
        );

        allow create: if isVerified() &&
          likeId == request.auth.uid &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'pending';

        allow update: if isVerified() &&
          isListingOwner(listingId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'approvedAt']) &&
          request.resource.data.status == 'approved';

        allow delete: if isVerified() && (
          request.auth.uid == likeId || isListingOwner(listingId)
        );
      }
    }

    // A conversation opened by an owner approving a like.
    match /matches/{matchId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participantUids;

      allow create: if isVerified() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.requesterUid != request.auth.uid &&
        request.resource.data.participantUids.size() == 2 &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.requesterUid in
          request.resource.data.participantUids &&
        request.resource.data.ownerUid ==
          listingData(request.resource.data.listingId).ownerUid &&
        exists(
          /databases/$(database)/documents/listings/$(request.resource.data.listingId)/likes/$(request.resource.data.requesterUid)
        );

      allow update: if isVerified() &&
        isParticipant(resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.requesterUid == resource.data.requesterUid &&
        request.resource.data.participantUids ==
          resource.data.participantUids;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);

        allow create: if isVerified() &&
          isMatchParticipant(matchId) &&
          request.resource.data.senderUid == request.auth.uid;

        // Only the structured viewing proposal fields may change after
        // creation. Message text and sender identity are immutable.
        allow update: if isVerified() &&
          isMatchParticipant(matchId) &&
          request.resource.data.senderUid == resource.data.senderUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['proposalStatus', 'viewingDate']);

        allow delete: if false;
      }
    }
  }
}
