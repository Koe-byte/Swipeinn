rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & Private swipes
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Private swipe actions (left and right swipes strictly private to the user)
      match /swipes/{targetId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Listings published by landlords
    match /listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.landlordUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.landlordUid == request.auth.uid;

      // Positive likes queue queryable by the listing's landlord
      match /likes/{studentUid} {
        allow create: if isOwner(studentUid);
        allow read: if isAuthenticated() && (
          isOwner(studentUid) || 
          get(/databases/$(database)/documents/listings/$(listingId)).data.landlordUid == request.auth.uid
        );
      }
    }

    // Bilateral Matches
    match /matches/{matchId} {
      // Accessible only to the matched Student and Landlord
      allow read: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );

      // Match creation requires reciprocal right-swipe
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid ||
        request.resource.data.landlordUid == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );

      // Real-time 1-on-1 Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/matches/$(matchId)).data.studentUid == request.auth.uid ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.landlordUid == request.auth.uid
        );

        // Security check for 24h First Move: student must initiate if messagesCount == 0
        allow create: if isAuthenticated() && (
          request.resource.data.senderUid == request.auth.uid
        );
      }
    }
  }
}
